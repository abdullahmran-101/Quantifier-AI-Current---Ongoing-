      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const o = $input.item.json.output;\nconst s = Math.max(0, Math.min(100, Number(o.lead_score) || 0));\no.lead_score = s;\no.lead_status = s >= 80 ? 'HOT' : s >= 50 ? 'WARM' : 'COLD';\nreturn { json: { output: o } };"
      },
